{
  "name": "dmx-receiver-simulator",
  "version": "1.0.0",
  "description": "Simulator for testing DMX receiver devices with configurable test scenarios",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "dmx",
    "sacn",
    "simulator",
    "testing"
  ],
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

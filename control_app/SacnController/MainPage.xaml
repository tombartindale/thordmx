<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SacnController.Controls"
             x:Class="SacnController.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1E1E1E">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="16">

        <!-- Title Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <Label Text="ThorDMX Pocket"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Label x:Name="UniverseLabel"
                       Text="Universe 1"
                       TextColor="#AAAAAA"
                       FontSize="14"
                       VerticalOptions="Center" />
                <Frame x:Name="WifiIndicator"
                       BackgroundColor="#44FF44"
                       CornerRadius="6"
                       WidthRequest="12"
                       HeightRequest="12"
                       Padding="0"
                       HasShadow="False"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Wi-Fi Warning Banner -->
        <Frame x:Name="WifiBanner"
               Grid.Row="1"
               BackgroundColor="#E6A700"
               Padding="12"
               CornerRadius="8"
               IsVisible="False"
               Margin="0,0,0,8">
            <Label Text="No Wi-Fi connection — sACN output disabled"
                   TextColor="Black"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
        </Frame>

        <!-- Color Wheel -->
        <controls:ColorWheelView x:Name="ColorWheel"
                                  Grid.Row="2"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill" />

        <!-- Brightness Slider -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <Label Text="☀"
                   TextColor="White"
                   FontSize="24"
                   VerticalOptions="Center"
                   Margin="0,0,8,0" />
            <Slider x:Name="BrightnessSlider"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="1"
                    Value="1"
                    MinimumTrackColor="#FFFFFF"
                    MaximumTrackColor="#555555"
                    ThumbColor="#FFFFFF" />
        </Grid>

        <!-- Color Preview + RGB Values -->
        <Grid Grid.Row="4" ColumnDefinitions="60,*" Margin="0,12,0,0">
            <BoxView x:Name="ColorPreview"
                     WidthRequest="50"
                     HeightRequest="50"
                     CornerRadius="8"
                     Color="White" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0,0,0">
                <Label x:Name="RedLabel" Text="R: 255" TextColor="White" FontSize="16" FontFamily="Monospace" />
                <Label x:Name="GreenLabel" Text="G: 255" TextColor="White" FontSize="16" FontFamily="Monospace" />
                <Label x:Name="BlueLabel" Text="B: 255" TextColor="White" FontSize="16" FontFamily="Monospace" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
